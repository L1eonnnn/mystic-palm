# GEMINI_API_KEY: Required for the official Google Gemini models (e.g. gemini-3.5-flash) on the server side.
GEMINI_API_KEY=

# OPENAI_API_KEY: Required for OpenAI GPT models (e.g. gpt-4o, gpt-4o-mini) on the server side.
OPENAI_API_KEY=

# VITE_DASHSCOPE_API_KEY: Required for Aliyun DashScope (Qwen-VL-Max) API calls.
VITE_DASHSCOPE_API_KEY="YOUR_ALIYUN_API_KEY"

# VITE_DEEPSEEK_API_KEY: Required for DeepSeek API calls.
VITE_DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"

# VITE_ZHIPU_API_KEY: Required for Zhipu (GLM-4V) API calls.
VITE_ZHIPU_API_KEY="YOUR_ZHIPU_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
